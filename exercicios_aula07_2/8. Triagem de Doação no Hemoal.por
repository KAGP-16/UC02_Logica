programa {
  funcao inicio() {
    
    real peso, idade

    escreva("Qual é o peso em kg do possível doador?\n")
      leia(peso)

          escreva("Qual é a idade do possível doador?\n")
            leia(idade)

            se(peso >= 50 e idade >= 16 <= 69)
{
                escreva("Ele está apto para doar.")
} 
                    senao
                        escreva("Ele não está apto para doar.")

    }
}
