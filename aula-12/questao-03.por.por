programa {
  funcao inicio() {

   // declaração de variáveis
   real nota1, nota2, media

   // entrada de dados
   escreva("Nota 1: ")
   leia(nota1)
   escreva("Nota 2: ")
   leia(nota2)
   
   // processamento de dados
   media = (nota1 + nota2) / 2

  // saída de dados
  escreva("Média: ", media)

  }
}
